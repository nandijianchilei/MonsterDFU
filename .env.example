# DFU LLM 配置说明
# 1. 复制本文件为 .env
# 2. 填写 DFU_LLM__API_KEY=你的Key（支持火山引擎/OpenAI/DeepSeek/混元等）
# 3. 启动程序后配置页面保存，状态栏会显示 LLM 连接状态
# ============================================================
# DFU 防御系统 - 环境变量示例
# 使用方法：复制本文件为 .env 并按需修改（桌面版/浏览器版均生效）
#   copy .env.example .env
# 环境变量命名规则：DFU_<SECTION>__<KEY>（见 config.py _env_override）
# ============================================================

# ---- LLM 配置（可选；留空则自动进入 Mock 模式）----
DFU_LLM__API_KEY=

# ---- Web 服务 ----
# 管理面板访问 Token（留空则每次启动随机生成并打印到控制台）
DFU_WEB_TOKEN=
# Web 服务端口（默认 8000；桌面版启动器在端口被占用时自动顺延）
DFU_WEB_SERVER__PORT=8000

# ---- 项目路径 ----
# 自定义项目根目录（默认取 web_server.py / desktop_launcher.py 所在目录）
# DFU_PROJECT_ROOT=

# ---- 检测灵敏度（可选）----
# 数据外传告警阈值（字节）
# DFU_EXFIL_THRESHOLD=20971520
